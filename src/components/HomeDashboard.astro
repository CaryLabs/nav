---
import CardIcon from './CardIcon.astro';
import type { PageData } from '../types/page';
import type { RenderContext } from '../types/render';
import { DEFAULT_RENDER_CONTEXT } from '../lib/view-data/render-context.ts';

interface Props {
  page?: PageData;
  renderContext?: RenderContext;
}

const { renderContext = DEFAULT_RENDER_CONTEXT } = Astro.props;

interface GlobalTool {
  /** 站点名称 */
  name: string;
  /** 一句话描述 */
  desc: string;
  /** 目标地址 */
  href: string;
  /** Font Awesome 6 免费版类名，如 'fas fa-globe' */
  icon: string;
}

// 首页「出海工具」快捷入口：新增/调整站点只需维护此数组，渲染结构会自动生成。
const globalTools: GlobalTool[] = [
  {
    name: 'Google Console',
    desc: 'Google 搜索表现管理',
    href: 'https://search.google.com/search-console',
    icon: 'fas fa-magnifying-glass-chart',
  },
  {
    name: 'Google Trends',
    desc: '探索全球搜索趋势',
    href: 'https://trends.google.com/explore?geo=US',
    icon: 'fas fa-chart-line',
  },
  {
    name: '哥伦布',
    desc: '哥伦布热榜数据',
    href: 'https://columbus.tools/ai-trends-rank',
    icon: 'fas fa-fire',
  },
  {
    name: 'easystarter',
    desc: 'easystarter趋势',
    href: 'https://www.easystarter.dev/zh/trends',
    icon: 'fas fa-arrow-trend-up',
  },
  {
    name: 'ahrefs',
    desc: '外链与 SEO 数据分析',
    href: 'https://ahrefs.com/',
    icon: 'fas fa-chart-column',
  },
  {
    name: 'Semrush',
    desc: 'SEO 与竞品分析套件',
    href: 'https://www.semrush.com/',
    icon: 'fas fa-bullhorn',
  },
  {
    name: 'huggingface',
    desc: 'AI 模型与数据集社区',
    href: 'https://huggingface.co/',
    icon: 'fas fa-robot',
  },
  {
    name: 'producthunt',
    desc: '新产品发布与发现',
    href: 'https://www.producthunt.com/',
    icon: 'fas fa-rocket',
  },
  {
    name: 'starterstory',
    desc: '独立创业者案例库',
    href: 'https://www.starterstory.com/',
    icon: 'fas fa-seedling',
  },
  {
    name: 'SEO BOX',
    desc: 'SEO 工具箱',
    href: 'https://seo.box/',
    icon: 'fas fa-toolbox',
  },
  {
    name: 'SimilarWeb',
    desc: '网站流量与市场分析',
    href: 'https://www.similarweb.com/',
    icon: 'fas fa-globe',
  },
  {
    name: 'SEO',
    desc: 'Google 搜索优化指南',
    href: 'https://developers.google.com/search/docs/fundamentals/get-started-developers?hl=zh-cn',
    icon: 'fas fa-book-open',
  },
];
---

<div class="dashboard-grid">
  <div class="dashboard-intro">
    <section class="category global-tools-card" aria-labelledby="global-tools-title">
      <div class="category-header">
        <h2 id="global-tools-title"><i class="fas fa-star" aria-hidden="true"></i>出海工具</h2>
      </div>
      <div class="sites-grid global-tools-grid">
        {
          globalTools.map((tool) => (
            <a class="site-card" href={tool.href} target="_blank" rel="noopener noreferrer">
              <CardIcon
                renderContext={renderContext}
                name={tool.name}
                url={tool.href}
                icon={tool.icon}
              />
              <div class="site-card-content">
                <h3>{tool.name}</h3>
                <p>{tool.desc}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <div class="dashboard-stats">
    <div class="dashboard-panel">
      <div class="panel-sidebar">
        <div class="panel-static-icon">
          <span class="fas fa-bars"></span>
        </div>
        <button
          class="panel-icon-btn add-btn"
          title="Add Todo"
          onclick="window.menavTodoApp.toggleInput()"
        >
          <span class="fas fa-plus"></span>
        </button>
      </div>

      <div class="panel-content-wrapper">
        <div class="panel-content custom-scrollbar" id="todo-list"></div>

        <div
          class="todo-input-container"
          id="todo-input-container"
          style="display: none; padding: var(--spacing-md);"
        >
          <input type="text" class="todo-input" id="todo-input-field" placeholder="New task..." />
          <button class="todo-add-btn-small" type="button">
            <span class="fas fa-arrow-right"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var TODO_STORAGE_KEY = 'menav_todos_v1';

    window.menavTodoApp = {
      todos: [],
      isIgnoreBlur: false,

      init: function () {
        this.load();
        this.bindInputEvents();
        this.render();
      },

      bindInputEvents: function () {
        var field = document.getElementById('todo-input-field');
        var button = document.querySelector('.todo-add-btn-small');
        if (field) {
          field.addEventListener('keydown', this.handleInputKey.bind(this));
          field.addEventListener('blur', this.handleBlur.bind(this));
        }
        if (button) {
          button.addEventListener('mousedown', this.preventBlur.bind(this));
          button.addEventListener('click', this.addFromInput.bind(this));
        }
      },

      load: function () {
        try {
          var raw = localStorage.getItem(TODO_STORAGE_KEY);
          this.todos = raw
            ? JSON.parse(raw)
            : [
                { text: 'Drink Water', done: false },
                { text: 'Explore MeNav', done: true },
              ];
        } catch (e) {
          this.todos = [];
        }
      },

      save: function () {
        try {
          localStorage.setItem(TODO_STORAGE_KEY, JSON.stringify(this.todos));
        } catch (e) {}
      },

      toggleInput: function () {
        var container = document.getElementById('todo-input-container');
        var field = document.getElementById('todo-input-field');
        if (!container || !field) return;
        if (container.style.display === 'none') {
          container.style.display = 'flex';
          field.focus();
        } else {
          container.style.display = 'none';
        }
      },

      handleBlur: function () {
        var self = this;
        setTimeout(function () {
          if (self.isIgnoreBlur) {
            self.isIgnoreBlur = false;
            return;
          }
          var container = document.getElementById('todo-input-container');
          if (container) container.style.display = 'none';
        }, 200);
      },

      preventBlur: function () {
        this.isIgnoreBlur = true;
      },

      addFromInput: function () {
        var input = document.getElementById('todo-input-field');
        if (input && input.value.trim()) {
          this.todos.push({ text: input.value.trim(), done: false });
          input.value = '';
          this.save();
          this.render();
          var list = document.getElementById('todo-list');
          if (list) list.scrollTop = list.scrollHeight;
          input.focus();
        }
      },

      handleInputKey: function (e) {
        if (e.key === 'Enter') this.addFromInput();
      },

      toggle: function (index) {
        this.todos[index].done = !this.todos[index].done;
        this.save();
        this.render();
      },

      remove: function (index, e) {
        if (e) e.stopPropagation();
        this.todos.splice(index, 1);
        this.save();
        this.render();
      },

      render: function () {
        var container = document.getElementById('todo-list');
        if (!container) return;
        if (this.todos.length === 0) {
          container.innerHTML = '<div class="empty-todo-hint">No tasks.</div>';
          return;
        }
        container.innerHTML = this.todos
          .map(
            function (todo, index) {
              return (
                '<div class="todo-item ' +
                (todo.done ? 'done' : '') +
                '" onclick="window.menavTodoApp.toggle(' +
                index +
                ')">' +
                '<div class="todo-checkbox ' +
                (todo.done ? 'checked' : '') +
                '">' +
                (todo.done ? '<span class="fas fa-check"></span>' : '') +
                '</div>' +
                '<div class="todo-text" title="' +
                this.escapeHtml(todo.text) +
                '">' +
                this.escapeHtml(todo.text) +
                '</div>' +
                '<button class="todo-delete-btn" onclick="window.menavTodoApp.remove(' +
                index +
                ', event)" title="Delete">' +
                '<span class="fas fa-trash-alt"></span>' +
                '</button></div>'
              );
            }.bind(this)
          )
          .join('');
      },

      escapeHtml: function (text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      },
    };

    window.menavTodoApp.init();
  })();
</script>

---
import { assetUrl } from '../lib/urls.ts';

interface Props {
  runtimeConfigJson?: string;
}

const { runtimeConfigJson = '{}' } = Astro.props;
---

<script
  is:inline
  id="menav-runtime-config"
  type="application/json"
  style="display: none;"
  set:html={runtimeConfigJson}
/>
<script is:inline src={assetUrl('pinyin-match.js')}></script>
<script is:inline src={assetUrl('script.js')}></script>
